# AccuWeather API Key (Free developer tier: developer.accuweather.com)
# When set, the system will query AccuWeather (up to 10 calls/day, cached daily)
# If left empty, or when the daily 10-call budget is reached, it seamlessly falls back to Open-Meteo.
VITE_ACCUWEATHER_API_KEY=

# Booking Email Worker (Cloudflare Worker) & Resend Secrets
RESENDAPI=
RESEND_FROM_EMAIL=
BOOKING_EMAIL_WORKER_SECRET=

# EmailJS transport used by the deployed Supabase functions. These are public
# EmailJS integration identifiers; configure the same values as Supabase
# function secrets when overriding the built-in Mt. Kalisungan defaults.
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
# Required when EmailJS account security has "Use Private Key" enabled.
EMAILJS_PRIVATE_KEY=
EMAILJS_BOOKING_TEMPLATE_ID=
EMAILJS_PASSWORD_RESET_TEMPLATE_ID=

# PayMongo: never put the secret key in VITE_* variables or commit it.
# Store PAYMONGO_SECRET_KEY as a Supabase/Vercel server secret if API checkout
# or webhook verification is enabled. The QR Ph asset is static and needs no key.
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Used only by Vercel API routes to authenticate and update the existing app
# database. Keep the service-role key server-side and never expose it as VITE_*.
SUPABASE_SERVICE_ROLE_KEY=
